# ==============================================================================
# NEURO//NODE • ENVIRONMENT CONFIGURATION EXAMPLE
# Copy to .env to customize local or deployment options
# ==============================================================================

# Node runtime mode
NODE_ENV=production

# Server HTTP and WebSocket port
PORT=8787

# Server listen host (0.0.0.0 binds to all network interfaces for LAN and Docker access)
HOST=0.0.0.0

# Directory for persistent JSON sync database
# Inside Docker, this defaults to /app/server/data (mounted via named volume)
DATA_DIR=/app/server/data

# Directory containing compiled production frontend assets
# Inside Docker, this defaults to /app/dist
STATIC_DIR=/app/dist
